# Copy to .env for local development (`npx expo start`). For store builds, add the same variable to the
# project's EAS environment variables instead of committing it anywhere.
#
# Shared key for signing report-server requests. Must equal the worker's REPORT_KEY secret
# (`cd worker && npx wrangler secret put REPORT_KEY`). Leave empty while the worker has no secret set.
EXPO_PUBLIC_REPORT_KEY=
